# Токен от @BotFather
BOT_TOKEN=

# Твой telegram id (узнать: @userinfobot). Только он имеет доступ.
OWNER_ID=

# Часовой пояс для дайджеста и расчёта дат
TZ=Europe/Moscow

# Час утреннего дайджеста (0-23)
DIGEST_HOUR=10

# Файл базы
DB_PATH=./data/crm.db

# Порт мини-аппа
PORT=3000

# Адрес мини-аппа, обязательно https — иначе Telegram его не откроет
PUBLIC_URL=

# 1 отключает проверку подписи Telegram. Только для локальной отладки в браузере.
ALLOW_INSECURE=0
